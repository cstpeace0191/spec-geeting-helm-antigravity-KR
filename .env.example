# Replace with a random secret of at least 32 bytes before starting the API.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes
PORT=3000

# Optional SQLite database path (defaults to backend/data/todo.db).
# SQLITE_DB_LOCATION=backend/data/todo.db

# Optional MySQL configuration; when MYSQL_HOST is set, MySQL is used instead of SQLite.
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=todo
# MYSQL_PASSWORD=replace-me
# MYSQL_DB=todo